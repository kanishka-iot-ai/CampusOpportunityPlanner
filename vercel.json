{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "database/**",
          "templates/**",
          "static/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "DB_HOST": "sqlite",
    "DB_USER": "cu_documents",
    "TRUSTED_HOSTS": "campus-opportunity-plan-cu.vercel.app,.vercel.app",
    "FLASK_SECRET_KEY": "campus-opportunity-planner-vercel-secure-session-key-production"
  }
}
